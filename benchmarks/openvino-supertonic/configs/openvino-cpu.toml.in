[backend]
kind = "supertonic"
runtime = "openvino"
device = "cpu"
threads = 2
fallback = "error"
device_id = 0

[backend.options]

[model]
family = "supertonic"
name = "@MODEL_NAME@"
directory = "@MODEL_DIR@"
duration_predictor = "duration_predictor.int8.onnx"
text_encoder = "text_encoder.int8.onnx"
vector_estimator = "@VECTOR_ESTIMATOR@"
vocoder = "vocoder.int8.onnx"
tts_json = "tts.json"
unicode_indexer = "unicode_indexer.bin"
voice_style = "voice.bin"
language = "en"
steps = 5
voice = 0

[model.options]

[audio]
device = "default"
volume = 1.0

[daemon]
queue_capacity = 8
max_text_bytes = 65536
